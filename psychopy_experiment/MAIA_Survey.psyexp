  <Flow>
    <Routine name="MAIA_Intro"/>
    <LoopInitiator loopType="TrialHandler" name="maia_loop">
      <Param name="Selected rows" updates="None" val="" valType="code"/>
      <Param name="conditions" updates="None" val="[{'item_num': 1, 'item_text': '나는 몸에서 불편감이 느껴지면, 그것을 바로 알아차린다.', 'subscale': 'Noticing', 'reverse': 0}, {'item_num': 2, 'item_text': '나는 정확하게 내 몸의 어느 부위가 편안하게 느껴지는지 알아차린다.', 'subscale': 'Noticing', 'reverse': 0}, {'item_num': 3, 'item_text': '나는 호흡의 변화, 즉 호흡이 느려지거나 빨라지는 것을 알아차린다.', 'subscale': 'Noticing', 'reverse': 0}, {'item_num': 4, 'item_text': '나는 불편한 감각이 느껴지면, 그것을 주의깊게 관찰한다.', 'subscale': 'Not-Distracting', 'reverse': 0}, {'item_num': 5, 'item_text': '나는 불편한 감정을 무언가에 집중함으로써 밀어낸다.', 'subscale': 'Not-Distracting', 'reverse': 1}, {'item_num': 6, 'item_text': '불쾌한 신체 감각을 느낄 때, 그것을 느끼지 않기 위해 다른 무언가에 나를 몰두시킨다.', 'subscale': 'Not-Distracting', 'reverse': 1}, {'item_num': 7, 'item_text': '나는 몸에서 통증을 느껴도 별로 당황하지 않는다.', 'subscale': 'Not-Worrying', 'reverse': 0}, {'item_num': 8, 'item_text': '나는 몸에서 어떤 불편함을 느껴도 별로 걱정하지 않는다.', 'subscale': 'Not-Worrying', 'reverse': 0}, {'item_num': 9, 'item_text': '불편함이나 통증을 느낄 때, 그것이 머릿속에서 떠나지 않는다.', 'subscale': 'Not-Worrying', 'reverse': 1}, {'item_num': 10, 'item_text': '나는 주변에서 많은 일이 일어나고 있어도 내부 신체감각에 대한 자각을 유지할 수 있다.', 'subscale': 'Attention-Regulation', 'reverse': 0}, {'item_num': 11, 'item_text': '나는 산만해지더라도, 다시 몸으로 주의를 돌릴 수 있다.', 'subscale': 'Attention-Regulation', 'reverse': 0}, {'item_num': 12, 'item_text': '나는 생각에서 몸의 감각으로 주의를 되돌릴 수 있다.', 'subscale': 'Attention-Regulation', 'reverse': 0}, {'item_num': 13, 'item_text': '평화로운 마음을 경험하고 나면, 내 몸이 다르게 느껴지는 것을 알아차린다.', 'subscale': 'Emotional-Awareness', 'reverse': 0}, {'item_num': 14, 'item_text': '마음이 편안하면, 호흡이 더 자유롭고 편안해지는 것을 알아차린다.', 'subscale': 'Emotional-Awareness', 'reverse': 0}, {'item_num': 15, 'item_text': '행복하거나 기쁠 때, 내 몸에서 어떤 변화가 일어나는지 알아차린다.', 'subscale': 'Emotional-Awareness', 'reverse': 0}, {'item_num': 16, 'item_text': '나는 주의를 몸에 둘 때, 고요함을 느낀다.', 'subscale': 'Self-Regulation', 'reverse': 0}, {'item_num': 17, 'item_text': '나는 호흡을 이용해서 긴장감을 줄일 수 있다.', 'subscale': 'Self-Regulation', 'reverse': 0}, {'item_num': 18, 'item_text': '나는 잡념에 사로잡힐 때, 몸 또는 호흡에 집중하여 마음을 고요하게 할 수 있다.', 'subscale': 'Self-Regulation', 'reverse': 0}, {'item_num': 19, 'item_text': '나는 몸을 통해 나의 기분 상태를 알아차린다.', 'subscale': 'Body-Listening', 'reverse': 0}, {'item_num': 20, 'item_text': '나는 당혹스러울 때, 내 몸이 그것을 어떻게 느끼는지 살피는 시간을 갖는다.', 'subscale': 'Body-Listening', 'reverse': 0}, {'item_num': 21, 'item_text': '나는 무엇을 해야 할지에 대한 정보를 얻고자 내 몸에 귀를 기울인다.', 'subscale': 'Body-Listening', 'reverse': 0}, {'item_num': 22, 'item_text': '나는 내 몸 안에서 편안함을 느낀다.', 'subscale': 'Trusting', 'reverse': 0}, {'item_num': 23, 'item_text': '나는 내 몸을 안전한 장소라고 느낀다.', 'subscale': 'Trusting', 'reverse': 0}, {'item_num': 24, 'item_text': '나는 내 몸의 감각을 신뢰한다.', 'subscale': 'Trusting', 'reverse': 0}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions/maia_items.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="maia_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="MAIA_Item"/>
    <LoopTerminator name="maia_loop"/>
    <Routine name="MAIA_End"/>
  </Flow>
</PsychoPy2experiment>
