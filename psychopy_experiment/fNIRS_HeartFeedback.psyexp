      <CodeComponent name="phase4_recovery" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="routineTimer.reset()&amp;#10;outlet.push_sample(['P4_recovery'])&amp;#10;print(f'[PSYCHOPY] Phase4_Recovery begin', flush=True)&amp;#10;bf.stop_ramp()&amp;#10;thisExp.addData('phase', 'P4_recovery')&amp;#10;thisExp.addData('mismatch_pct', 0.0)&amp;#10;thisExp.addData('phase_onset', core.getTime())&amp;#10;mini_epoch_count = 0&amp;#10;try:&amp;#10;    base_bpm = float(expInfo.get('baseline_bpm', 70))&amp;#10;except Exception:&amp;#10;    base_bpm = 70&amp;#10;# --- 블록 요약: 이 블록에서 적용된 조작 정도 (몇 % 증가/감소) ---&amp;#10;_tp = bf.get_target_pct()&amp;#10;thisExp.addData('summary_block_idx', idx)&amp;#10;thisExp.addData('summary_block_type', block_type)&amp;#10;thisExp.addData('summary_target_pct', _tp)&amp;#10;thisExp.addData('summary_direction', {'accel': 'increase', 'decel': 'decrease'}.get(block_type, 'none'))&amp;#10;thisExp.addData('summary_baseline_bpm', round(base_bpm, 2))&amp;#10;thisExp.addData('summary_plateau_bpm', round(base_bpm * (1 + _tp / 100.0), 2))&amp;#10;thisExp.addData('summary_peak_mismatch_pct', _tp)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if 'q' in event.getKeys(keyList=['q']):&amp;#10;    print('[PSYCHOPY] [Q] skip -&gt; next phase (Phase4_Recovery)', flush=True)&amp;#10;    continueRoutine = False&amp;#10;status_text.text = f'P4_recovery  block[{idx+1}/3]={block_type}  bpm={base_bpm:.0f}  t={t:.1f}/60s'&amp;#10;try:&amp;#10;    thisExp.addData('actual_bpm', bf.get_real_bpm())&amp;#10;    thisExp.addData('actual_bpm_t', t)&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P4 bpm log err: {_e!r}', flush=True)&amp;#10;try:&amp;#10;    if ecg_renderer is not None:&amp;#10;        ecg_renderer.update(t, base_bpm)&amp;#10;        ecg_renderer.draw()&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P4 ECG err: {_e!r}', flush=True)&amp;#10;status_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
