        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="code_2" plugin="None">
        <Param val="import os, sys, subprocess&amp;#10;# stdout/stderr를 UTF-8로 강제 (Windows cp949에서 PsychoPy Runner 디코딩 에러 방지)&amp;#10;try:&amp;#10;    sys.stdout.reconfigure(encoding='utf-8', errors='replace')&amp;#10;    sys.stderr.reconfigure(encoding='utf-8', errors='replace')&amp;#10;except Exception:&amp;#10;    pass&amp;#10;from pylsl import StreamInfo, StreamOutlet, StreamInlet, resolve_byprop&amp;#10;&amp;#10;print('[psychopy] === Before Experiment ===')&amp;#10;&amp;#10;# psychopy_experiment 폴더를 sys.path에 (ecg_renderer import용)&amp;#10;_here = os.path.dirname(os.path.abspath(__file__))&amp;#10;if _here not in sys.path:&amp;#10;    sys.path.insert(0, _here)&amp;#10;&amp;#10;# 프로젝트 경로 (biofeedback 폴더 위치)&amp;#10;project_dir = None&amp;#10;for c in (_here, os.path.abspath(os.getcwd()), os.path.dirname(os.path.abspath(os.getcwd()))):&amp;#10;    for d in (c, os.path.dirname(c)):&amp;#10;        if os.path.isdir(os.path.join(d, 'biofeedback')):&amp;#10;            project_dir = d; break&amp;#10;    if project_dir: break&amp;#10;print(f'[psychopy] project_dir = {project_dir}')&amp;#10;&amp;#10;# 바이오피드백 subprocess 실행 (이미 떠있으면 skip)&amp;#10;if project_dir is not None:&amp;#10;    _existing = resolve_byprop('name', 'BiofeedbackControl', 1, 0.3)&amp;#10;    if _existing:&amp;#10;        print('[psychopy] biofeedback already running')&amp;#10;    else:&amp;#10;        python_exe = os.path.join(project_dir, '.venv', 'Scripts', 'python.exe')&amp;#10;        if not os.path.exists(python_exe):&amp;#10;            python_exe = sys.executable&amp;#10;        try:&amp;#10;            _log_path = os.path.join(project_dir, 'biofeedback_console.log')&amp;#10;            _log_f = open(_log_path, 'w', encoding='utf-8')&amp;#10;            subprocess.Popen(&amp;#10;                [python_exe, '-m', 'biofeedback.main'],&amp;#10;                cwd=project_dir,&amp;#10;                stdout=_log_f, stderr=subprocess.STDOUT,&amp;#10;                creationflags=(0x08000000 if os.name == 'nt' else 0),&amp;#10;            )&amp;#10;            print(f'[psychopy] biofeedback launched, log: {_log_path}')&amp;#10;        except Exception as _e:&amp;#10;            print(f'[psychopy] subprocess failed: {_e!r}')&amp;#10;&amp;#10;# LSL outlet PsychoPy → biofeedback&amp;#10;info = StreamInfo('PsychoPyMarkers', 'Markers', 1, 0, 'string', 'psychopy_markers')&amp;#10;outlet = StreamOutlet(info)&amp;#10;print('[psychopy] outlet PsychoPyMarkers created')&amp;#10;&amp;#10;# Inlets는 None으로 시작, Welcome Each Frame에서 lazy resolve&amp;#10;bpm_inlet = None&amp;#10;cal_inlet = None&amp;#10;control_inlet = None&amp;#10;_inlet_check_counter = 0" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# === ECG renderer 초기화 ===&amp;#10;_ecg_init_err = None&amp;#10;try:&amp;#10;    import ecg_renderer&amp;#10;    ecg_renderer.init(win)&amp;#10;except Exception as _e:&amp;#10;    import traceback&amp;#10;    _ecg_init_err = f'{_e!r}'&amp;#10;    traceback.print_exc()&amp;#10;    ecg_renderer = None&amp;#10;&amp;#10;# 진단용 status TextStim&amp;#10;from psychopy import visual as _v&amp;#10;status_text = _v.TextStim(&amp;#10;    win, name='status_text',&amp;#10;    text='', pos=(0, -0.45), units='height',&amp;#10;    color='yellow', height=0.022,&amp;#10;    alignText='center',&amp;#10;)&amp;#10;# FPS 측정용&amp;#10;_fps_frames = 0&amp;#10;_fps_t0 = core.getTime()&amp;#10;_fps_cur = 0.0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Lazy LSL inlet resolution + 마커 polling&amp;#10;try:&amp;#10;    _inlet_check_counter += 1&amp;#10;    if _inlet_check_counter % 30 == 0:&amp;#10;        if control_inlet is None:&amp;#10;            _s = resolve_byprop('name', 'BiofeedbackControl', 1, 0.0)&amp;#10;            if _s: control_inlet = StreamInlet(_s[0]); print('[psychopy] control_inlet OK')&amp;#10;        if bpm_inlet is None:&amp;#10;            _s = resolve_byprop('name', 'BPM_processed', 1, 0.0)&amp;#10;            if _s: bpm_inlet = StreamInlet(_s[0]); print('[psychopy] bpm_inlet OK')&amp;#10;        if cal_inlet is None:&amp;#10;            _s = resolve_byprop('name', 'Calibration_Result', 1, 0.0)&amp;#10;            if _s: cal_inlet = StreamInlet(_s[0]); print('[psychopy] cal_inlet OK')&amp;#10;    # cal_inlet 먼저 폴링 (control_inlet보다 우선)&amp;#10;    if cal_inlet is not None:&amp;#10;        sample, _ = cal_inlet.pull_sample(timeout=0.0)&amp;#10;        if sample:&amp;#10;            expInfo['baseline_bpm'] = float(sample[0])&amp;#10;            print(f'[psychopy] baseline_bpm received from Calibration_Result: {sample[0]}')&amp;#10;    # control_inlet에 baseline_bpm이 결합되어 올 수도 있음 (experiment_start:65.5)&amp;#10;    if control_inlet is not None:&amp;#10;        sample, _ = control_inlet.pull_sample(timeout=0.0)&amp;#10;        if sample and 'experiment_start' in sample[0]:&amp;#10;            _parts = sample[0].split(':')&amp;#10;            if len(_parts) &gt;= 2:&amp;#10;                try:&amp;#10;                    expInfo['baseline_bpm'] = float(_parts[1])&amp;#10;                    print(f'[psychopy] baseline_bpm parsed from control marker: {_parts[1]}')&amp;#10;                except ValueError:&amp;#10;                    pass&amp;#10;            continueRoutine = False&amp;#10;except Exception as _e:&amp;#10;    print(f'[psychopy] welcome poll error: {_e!r}')" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('baseline_bpm', expInfo.get('baseline_bpm', 70.0))" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_2" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="Daily_Screening">
      <RoutineSettingsComponent name="Daily_Screening" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
