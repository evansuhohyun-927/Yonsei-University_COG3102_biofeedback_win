        <Param val="# 참가자 창의 ECG를 숨기고 Likert 텍스트를 표시하라고 biofeedback에 알림&amp;#10;_likert_msg = text_inblock.text.replace('\n', '  ')&amp;#10;outlet.push_sample([f'likert_on:{_likert_msg}'])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
