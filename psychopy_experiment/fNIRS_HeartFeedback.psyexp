        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <TextComponent name="fix_p1" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.15" valType="num" updates="constant" name="letterHeight"/>
        <Param val="fix_p1" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="60" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="code_p1" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# CRITICAL: routineTimer 강제 리셋 (non-slip 누적 방지 — while loop 진입 보장)&amp;#10;routineTimer.reset()&amp;#10;try:&amp;#10;    idx = block_loop.thisN if hasattr(block_loop, 'thisN') else 0&amp;#10;    block_type = block_sequence[idx]['block_type']&amp;#10;    direction = block_sequence[idx]['direction']&amp;#10;    print(f'[PSYCHOPY] Phase1_Sync block[{idx+1}/3]={block_type} begin', flush=True)&amp;#10;    outlet.push_sample([block_type])&amp;#10;    outlet.push_sample(['P1_sync'])&amp;#10;    bf.set_block_type(block_type)&amp;#10;    block_target_pct = bf.get_target_pct()&amp;#10;    block_direction = {'accel': 'increase', 'decel': 'decrease'}.get(block_type, 'none')&amp;#10;    thisExp.addData('block_type', block_type)&amp;#10;    thisExp.addData('block_target_pct', block_target_pct)&amp;#10;    thisExp.addData('block_direction', block_direction)&amp;#10;    thisExp.addData('block_idx', idx)&amp;#10;    thisExp.addData('phase', 'P1_sync')&amp;#10;    thisExp.addData('phase_onset', core.getTime())&amp;#10;    try:&amp;#10;        base_bpm = float(expInfo.get('baseline_bpm', 70))&amp;#10;    except:&amp;#10;        base_bpm = 70&amp;#10;    current_phase_label = 'P2_ramp_end'&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY ERROR] Phase1_Sync Begin Routine: {_e!r}', flush=True)&amp;#10;    import traceback; traceback.print_exc()&amp;#10;    idx = 0&amp;#10;    block_type = 'neutral'&amp;#10;    direction = 'same'&amp;#10;    block_target_pct = 0.0&amp;#10;    block_direction = 'none'&amp;#10;    base_bpm = 70&amp;#10;    current_phase_label = 'P2_ramp_end'" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# status_text는 ECG와 분리 — ECG 예외에도 status는 항상 갱신/표시&amp;#10;if 'q' in event.getKeys(keyList=['q']):&amp;#10;    print('[PSYCHOPY] [Q] skip -&gt; next phase (Phase1_Sync)', flush=True)&amp;#10;    continueRoutine = False&amp;#10;status_text.text = f'P1_sync  block[{idx+1}/3]={block_type}  bpm={base_bpm:.0f}  t={t:.1f}/60s  (60초 후 자동 진행)'&amp;#10;try:&amp;#10;    thisExp.addData('actual_bpm', bf.get_real_bpm())&amp;#10;    thisExp.addData('actual_bpm_t', t)&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P1 bpm log err: {_e!r}', flush=True)&amp;#10;try:&amp;#10;    if ecg_renderer is not None:&amp;#10;        ecg_renderer.update(t, base_bpm)&amp;#10;        ecg_renderer.draw()&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P1 ECG err: {_e!r}', flush=True)&amp;#10;    status_text.text = f'P1_sync  ECG ERROR: {_e!r}  t={t:.1f}/60s'&amp;#10;status_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="print(f'[PSYCHOPY] Phase1_Sync END (60s reached). Moving to ramp_loop -&gt; Phase2_Mini_')" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_p1" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="Phase2_Mini_">
      <RoutineSettingsComponent name="Phase2_Mini_" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[-1,-1,-1]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="Phase2_Mini_" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <TextComponent name="fix_mini" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.15" valType="num" updates="constant" name="letterHeight"/>
        <Param val="fix_mini" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="20" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="code_mini" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="mini_epoch_count = 0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# CRITICAL: routineTimer 강제 리셋&amp;#10;routineTimer.reset()&amp;#10;try:&amp;#10;    outlet.push_sample(['P2_ramp'])&amp;#10;    mini_epoch_count += 1&amp;#10;    if mini_epoch_count == 1:&amp;#10;        bf.start_ramp()&amp;#10;    elapsed_total = (mini_epoch_count - 1) * 20&amp;#10;    print(f'[PSYCHOPY] Phase2_Mini_ ep{mini_epoch_count}/9 begin', flush=True)&amp;#10;    try:&amp;#10;        base_bpm = float(expInfo.get('baseline_bpm', 70))&amp;#10;    except:&amp;#10;        base_bpm = 70&amp;#10;    # idx와 block_type은 Phase1_Sync에서 설정됨&amp;#10;    if 'idx' not in dir() or 'block_type' not in dir():&amp;#10;        idx = block_loop.thisN if hasattr(block_loop, 'thisN') else 0&amp;#10;        block_type = block_sequence[idx]['block_type']&amp;#10;    mismatch_now = min(25.0, (elapsed_total / 180.0) * 25.0)&amp;#10;    if block_type == 'accel':&amp;#10;        current_bpm = base_bpm * (1 + mismatch_now / 100.0)&amp;#10;    elif block_type == 'decel':&amp;#10;        current_bpm = base_bpm * (1 - mismatch_now / 100.0)&amp;#10;    else:&amp;#10;        mismatch_now = 0.0&amp;#10;        current_bpm = base_bpm&amp;#10;    thisExp.addData('phase', 'P2_ramp')&amp;#10;    thisExp.addData('epoch_num', mini_epoch_count)&amp;#10;    thisExp.addData('mismatch_pct', round(mismatch_now, 2))&amp;#10;    signed_mismatch = mismatch_now if block_type == 'accel' else (-mismatch_now if block_type == 'decel' else 0.0)&amp;#10;    thisExp.addData('signed_mismatch_pct', round(signed_mismatch, 2))&amp;#10;    thisExp.addData('manip_pct_actual', round(bf.get_manipulation_pct(), 2))&amp;#10;    thisExp.addData('manip_state', bf.get_manipulator_state())&amp;#10;    thisExp.addData('block_target_pct', bf.get_target_pct())&amp;#10;    thisExp.addData('current_bpm', round(current_bpm, 2))&amp;#10;    thisExp.addData('block_type', block_type)&amp;#10;    thisExp.addData('phase_onset', core.getTime())&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY ERROR] Phase2_Mini_ Begin Routine: {_e!r}')&amp;#10;    import traceback; traceback.print_exc()&amp;#10;    # fallback 값으로 진행 (창 닫지 않음)&amp;#10;    base_bpm = 70&amp;#10;    current_bpm = 70&amp;#10;    mismatch_now = 0.0&amp;#10;    block_type = 'neutral'&amp;#10;    idx = 0" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if 'q' in event.getKeys(keyList=['q']):&amp;#10;    print('[PSYCHOPY] [Q] skip -&gt; next phase (whole Phase2 ramp_loop)', flush=True)&amp;#10;    ramp_loop.finished = True&amp;#10;    continueRoutine = False&amp;#10;status_text.text = f'P2_ramp  block[{idx+1}/3]={block_type}  ep{mini_epoch_count}/9  bpm={current_bpm:.0f}  mismatch={mismatch_now:.0f}%  t={t:.1f}/20s'&amp;#10;try:&amp;#10;    thisExp.addData('actual_bpm', bf.get_real_bpm())&amp;#10;    thisExp.addData('actual_bpm_t', t)&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P2 bpm log err: {_e!r}', flush=True)&amp;#10;try:&amp;#10;    if ecg_renderer is not None:&amp;#10;        ecg_renderer.update(t, current_bpm)&amp;#10;        ecg_renderer.draw()&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P2 ECG err: {_e!r}', flush=True)&amp;#10;status_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_mini" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
