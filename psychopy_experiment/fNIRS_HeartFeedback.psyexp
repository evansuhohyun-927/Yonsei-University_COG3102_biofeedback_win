        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="code_2" plugin="None">
        <Param val="import os, sys&amp;#10;# stdout/stderr를 UTF-8로 강제 (Windows cp949에서 PsychoPy Runner 디코딩 에러 방지)&amp;#10;try:&amp;#10;    sys.stdout.reconfigure(encoding='utf-8', errors='replace')&amp;#10;    sys.stderr.reconfigure(encoding='utf-8', errors='replace')&amp;#10;except Exception:&amp;#10;    pass&amp;#10;print('[psychopy] === Before Experiment (inline) ===')&amp;#10;&amp;#10;# psychopy_experiment 폴더를 sys.path에 (ecg_renderer / biofeedback_inline import용)&amp;#10;_here = os.path.dirname(os.path.abspath(__file__))&amp;#10;if _here not in sys.path:&amp;#10;    sys.path.insert(0, _here)&amp;#10;&amp;#10;# 단일 프로세스 biofeedback 코어 (subprocess / LSL inlet 불필요)&amp;#10;import biofeedback_inline as bf&amp;#10;&amp;#10;# fNIRS 동기용 마커 outlet. pylsl 없으면 더미로 대체.&amp;#10;class _NullOutlet:&amp;#10;    def push_sample(self, *a, **k):&amp;#10;        pass&amp;#10;outlet = _NullOutlet()&amp;#10;try:&amp;#10;    from pylsl import StreamInfo, StreamOutlet&amp;#10;    info = StreamInfo('PsychoPyMarkers', 'Markers', 1, 0, 'string', 'psychopy_markers')&amp;#10;    outlet = StreamOutlet(info)&amp;#10;    print('[psychopy] outlet PsychoPyMarkers created (fNIRS sync)')&amp;#10;except Exception as _e:&amp;#10;    print(f'[psychopy] LSL outlet unavailable: {_e!r}')&amp;#10;&amp;#10;# 모든 마커 push를 이벤트 CSV에도 기록(snirf 마커 소스). LSL은 그대로 전달.&amp;#10;class _LoggingOutlet:&amp;#10;    def __init__(self, inner):&amp;#10;        self._inner = inner&amp;#10;    def push_sample(self, x, *a, **k):&amp;#10;        try:&amp;#10;            self._inner.push_sample(x, *a, **k)&amp;#10;        except Exception:&amp;#10;            pass&amp;#10;        try:&amp;#10;            _lab = x[0] if isinstance(x, (list, tuple)) else x&amp;#10;            bf.log_marker(str(_lab))&amp;#10;        except Exception:&amp;#10;            pass&amp;#10;outlet = _LoggingOutlet(outlet)" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# === 단일 프로세스 biofeedback 시작 ===&amp;#10;_ppg_port = str(expInfo.get('ppg_port', '') or '').strip()&amp;#10;_src = 'mock' if _ppg_port.lower() == 'mock' else 'ppg'&amp;#10;try:&amp;#10;    bf.start(source=_src, ppg_port=_ppg_port, audio_on=True)&amp;#10;    _active = bf.get_active_port() or 'mock'&amp;#10;    expInfo['ppg_port'] = _active&amp;#10;    print(f'[psychopy] bf.start ok (source={_src}, active={_active!r})')&amp;#10;except Exception as _e:&amp;#10;    import traceback; traceback.print_exc()&amp;#10;    print(f'[psychopy] bf.start FAILED: {_e!r}')&amp;#10;&amp;#10;# === ECG renderer 초기화 ===&amp;#10;_ecg_init_err = None&amp;#10;try:&amp;#10;    import ecg_renderer&amp;#10;    ecg_renderer.init(win)&amp;#10;except Exception as _e:&amp;#10;    import traceback&amp;#10;    _ecg_init_err = f'{_e!r}'&amp;#10;    traceback.print_exc()&amp;#10;    ecg_renderer = None&amp;#10;&amp;#10;# 진단용 status HUD — 운영 시 비활성(_HUD_DEBUG=False)&amp;#10;# True면 매 프레임 TextStim 텍스처 재생성 → 장시간 후 네이티브 크래시 위험&amp;#10;_HUD_DEBUG = False&amp;#10;if _HUD_DEBUG:&amp;#10;    from psychopy import visual as _v&amp;#10;    status_text = _v.TextStim(&amp;#10;        win, name='status_text',&amp;#10;        text='', pos=(0, -0.45), units='height',&amp;#10;        color='yellow', height=0.022,&amp;#10;        alignText='center',&amp;#10;    )&amp;#10;else:&amp;#10;    class _NullHUD:&amp;#10;        text = ''&amp;#10;        def draw(self, *a, **k):&amp;#10;            pass&amp;#10;        def setAutoDraw(self, *a, **k):&amp;#10;            pass&amp;#10;    status_text = _NullHUD()&amp;#10;# FPS 측정용&amp;#10;_fps_frames = 0&amp;#10;_fps_t0 = core.getTime()&amp;#10;_fps_cur = 0.0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# 단일 프로세스 모드 — LSL inlet 폴링 불필요. 스페이스(key_welcome)로 진행." valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('baseline_bpm', expInfo.get('baseline_bpm', 70.0))" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_2" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
