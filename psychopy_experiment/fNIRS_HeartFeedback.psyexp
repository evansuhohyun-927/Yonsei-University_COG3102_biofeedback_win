        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="outlet.push_sample(['baseline'])&amp;#10;thisExp.addData('phase', 'baseline')&amp;#10;thisExp.addData('phase_onset', core.getTime())&amp;#10;try:&amp;#10;    base_bpm = float(expInfo.get('baseline_bpm', 70))&amp;#10;except Exception:&amp;#10;    base_bpm = 70" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if 'q' in event.getKeys(keyList=['q']):&amp;#10;    print('[PSYCHOPY] [Q] skip -&gt; next phase (Baseline)', flush=True)&amp;#10;    continueRoutine = False&amp;#10;# Baseline 동안 ECG/하트 표시 (참가자 baseline BPM)&amp;#10;if ecg_renderer is not None:&amp;#10;    try:&amp;#10;        ecg_renderer.update(t, base_bpm)&amp;#10;        ecg_renderer.draw()&amp;#10;        status_text.text = f'Baseline  bpm={base_bpm:.0f}  t={t:.1f}'&amp;#10;    except Exception as _e:&amp;#10;        status_text.text = f'ECG draw error: {_e!r}'&amp;#10;else:&amp;#10;    status_text.text = f'Baseline  ECG=None  init_err={_ecg_init_err}'&amp;#10;status_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
