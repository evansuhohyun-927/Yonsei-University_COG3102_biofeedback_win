        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="[실험 안내]&amp;#10;&amp;#10;지금부터 메트로놈 소리가 들립니다.&amp;#10;이 소리를 여러분의 심장 박동 소리로&amp;#10;생각해 주시기 바랍니다.&amp;#10;&amp;#10;실험 중 주의사항:&amp;#10;  · 화면 중앙을 계속 바라봐 주세요&amp;#10;  · 몸을 최대한 움직이지 말아 주세요&amp;#10;  · 편안하게 호흡하세요&amp;#10;&amp;#10;중간에 숫자 질문이 나오면&amp;#10;키보드 숫자(1~7)로 응답해 주세요.&amp;#10;&amp;#10;실험은 약 30분 진행됩니다.&amp;#10;&amp;#10;준비되셨으면 스페이스바를 누르세요." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="0.88" valType="num" updates="constant" name="wrapWidth"/>
