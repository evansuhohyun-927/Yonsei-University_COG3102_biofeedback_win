        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="PPG Calibration" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="0.88" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="code_ppg_setup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="from psychopy import event&amp;#10;_calib_started = False&amp;#10;calib_start_t = None&amp;#10;CALIB_DURATION = 60.0&amp;#10;_src_status_line = '연결 확인하려면 [R]'&amp;#10;print('[psychopy] PPG_Setup (experimenter panel) begin', flush=True)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="from psychopy import event&amp;#10;_keys = event.getKeys(keyList=['c', 'r', 's', 'd', 'space'])&amp;#10;&amp;#10;# [C]: 60초 baseline 측정 (재)시작&amp;#10;if 'c' in _keys:&amp;#10;    if (not _calib_started) or bf.is_calibration_done():&amp;#10;        outlet.push_sample(['calibration_start'])  # fNIRS 동기 마커&amp;#10;        bf.start_calibration()&amp;#10;        calib_start_t = core.getTime()&amp;#10;        _calib_started = True&amp;#10;        print('[psychopy] calibration started', flush=True)&amp;#10;&amp;#10;# [S]: 소리 ON/OFF 토글&amp;#10;if 's' in _keys:&amp;#10;    _on = bf.toggle_audio()&amp;#10;    print('[psychopy] audio ->', 'ON' if _on else 'OFF', flush=True)&amp;#10;&amp;#10;# [D]: 소리 출력 장치 변경 (이어폰 등으로 라우팅)&amp;#10;if 'd' in _keys:&amp;#10;    _dev = bf.cycle_audio_device()&amp;#10;    print('[psychopy] audio device ->', _dev, flush=True)&amp;#10;&amp;#10;# [R]: 포트 연결 새로고침/확인&amp;#10;if 'r' in _keys:&amp;#10;    _st = bf.refresh_source()&amp;#10;    _src_status_line = '연결: ' + str(_st.get('detail', _st))&amp;#10;    print('[psychopy] source refresh:', _st, flush=True)&amp;#10;&amp;#10;_audio_txt = 'ON' if bf.is_audio_on() else 'OFF'&amp;#10;_dev_txt = bf.get_audio_device_name()&amp;#10;_src_txt = (str(expInfo.get('ppg_port')) + ' (PPG 실측)') if bf.is_ppg_active() else 'mock (가짜 70 BPM!)'&amp;#10;if not _calib_started:&amp;#10;    text_device.text = (&amp;#10;        f'[실험자 설정 화면]\n\n'&amp;#10;        f'PPG 소스: {_src_txt}      소리: {_audio_txt}\n'&amp;#10;        f'소리 출력 장치: {_dev_txt}\n'&amp;#10;        f'{_src_status_line}\n'&amp;#10;        f'실측 심박: {bf.get_real_bpm():.1f} BPM   (시각자극 출력 {bf.get_output_bpm():.1f})\n\n'&amp;#10;        f'[C] Baseline 측정    [R] 포트 새로고침\n'&amp;#10;        f'[S] 소리 켜기/끄기    [D] 소리 출력 장치 변경\n'&amp;#10;        f'[Space] 실험 시작'&amp;#10;    )&amp;#10;elif not bf.is_calibration_done():&amp;#10;    _remaining = max(0, CALIB_DURATION - (core.getTime() - calib_start_t))&amp;#10;    text_device.text = (&amp;#10;        f'Baseline 측정 중...   {_remaining:0.0f}초 남음\n\n'&amp;#10;        f'(참가자: 편안히 휴식, 움직이지 마세요)\n\n'&amp;#10;        f'소리: {_audio_txt} ({_dev_txt})      실시간 출력 BPM: {bf.get_output_bpm():.1f}'&amp;#10;    )&amp;#10;else:&amp;#10;    _bpm = bf.get_baseline_bpm() or 70.0&amp;#10;    expInfo['baseline_bpm'] = float(_bpm)&amp;#10;    text_device.text = (&amp;#10;        f'Baseline 완료:  {_bpm:.1f} BPM      소리: {_audio_txt}\n'&amp;#10;        f'소리 출력 장치: {_dev_txt}\n\n'&amp;#10;        f'[C] 다시 측정   [R] 포트   [S] 소리   [D] 출력장치   [Space] 시작'&amp;#10;    )&amp;#10;&amp;#10;# ECG/하트 미리보기&amp;#10;if ecg_renderer is not None:&amp;#10;    try:&amp;#10;        ecg_renderer.update(t, bf.get_output_bpm())&amp;#10;        ecg_renderer.draw()&amp;#10;    except Exception:&amp;#10;        pass&amp;#10;&amp;#10;# [Space]: 실험 진행&amp;#10;if 'space' in _keys:&amp;#10;    if bf.is_calibration_done() and bf.get_baseline_bpm():&amp;#10;        expInfo['baseline_bpm'] = float(bf.get_baseline_bpm())&amp;#10;    elif 'baseline_bpm' not in expInfo:&amp;#10;        expInfo['baseline_bpm'] = 70.0&amp;#10;    outlet.push_sample(['experiment_start'])  # fNIRS 동기 마커&amp;#10;    print('[psychopy] experiment_start (experimenter pressed Space)', flush=True)&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('baseline_bpm', expInfo.get('baseline_bpm', 70.0))" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_ppg_setup" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
