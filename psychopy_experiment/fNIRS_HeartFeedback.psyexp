        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="[당일 포함/제외 기준 확인]&amp;#10;&amp;#10;-포함 기준&amp;#10;✓ 만 18세 이상 건강한 성인&amp;#10;✓ 신경학적·정신과적 질환 없음&amp;#10;✓ 심혈관계 약물 미복용 (베타차단제 등)&amp;#10;✓ 심혈관계 질환 없음&amp;#10;&amp;#10;-제외 기준&amp;#10;✗ 실험 30분 전 격한 운동&amp;#10;✗ 실험 30분 전 커피 섭취&amp;#10;&amp;#10;모두 충족 → Y     해당 있음 → N" valType="str" updates="constant" name="text"/>
