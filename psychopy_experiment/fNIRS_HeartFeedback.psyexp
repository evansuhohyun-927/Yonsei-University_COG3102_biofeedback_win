        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="[디브리핑]&amp;#10;&amp;#10;실험에 참여해주셔서 감사합니다.&amp;#10;&amp;#10;사실 오늘 들으셨던 메트로놈 소리는&amp;#10;실제 심장 박동 소리가 아닌,&amp;#10;인위적으로 조작된 신호였습니다.&amp;#10;&amp;#10;이 연구는 외부에서 주어진 가짜 신체 신호가&amp;#10;전두엽 뇌 활동과 내수용 감각에&amp;#10;어떤 영향을 미치는지 연구합니다.&amp;#10;&amp;#10;궁금한 점이 있으시면&amp;#10;실험자에게 자유롭게 질문해 주세요.&amp;#10;&amp;#10;수고하셨습니다.&amp;#10;&amp;#10;[스페이스바] 종료" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="0.88" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="debief" plugin="None">
        <Param val="'space'" valType="list" updates="constant" name="allowedKeys"/>
