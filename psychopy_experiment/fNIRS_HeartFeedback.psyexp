        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="routineTimer.reset()&amp;#10;outlet.push_sample(['P3_plateau'])&amp;#10;print(f'[PSYCHOPY] Phase3_Plateau begin', flush=True)&amp;#10;current_phase_label = 'P3_plateau_end'&amp;#10;thisExp.addData('phase', 'P3_plateau')&amp;#10;thisExp.addData('mismatch_pct', 25.0 if block_type != 'neutral' else 0.0)&amp;#10;thisExp.addData('signed_mismatch_pct', bf.get_target_pct())&amp;#10;thisExp.addData('manip_pct_actual', round(bf.get_manipulation_pct(), 2))&amp;#10;thisExp.addData('manip_state', bf.get_manipulator_state())&amp;#10;thisExp.addData('block_target_pct', bf.get_target_pct())&amp;#10;thisExp.addData('block_direction', {'accel': 'increase', 'decel': 'decrease'}.get(block_type, 'none'))&amp;#10;thisExp.addData('phase_onset', core.getTime())&amp;#10;try:&amp;#10;    base_bpm = float(expInfo.get('baseline_bpm', 70))&amp;#10;except:&amp;#10;    base_bpm = 70&amp;#10;if block_type == 'accel':&amp;#10;    plateau_bpm = base_bpm * 1.25&amp;#10;elif block_type == 'decel':&amp;#10;    plateau_bpm = base_bpm * 0.75&amp;#10;else:&amp;#10;    plateau_bpm = base_bpm" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if 'q' in event.getKeys(keyList=['q']):&amp;#10;    print('[PSYCHOPY] [Q] skip -&gt; next phase (Phase3_Plateau)', flush=True)&amp;#10;    continueRoutine = False&amp;#10;status_text.text = f'P3_plateau  block[{idx+1}/3]={block_type}  bpm={plateau_bpm:.0f}  t={t:.1f}/45s'&amp;#10;try:&amp;#10;    thisExp.addData('actual_bpm', bf.get_real_bpm())&amp;#10;    thisExp.addData('actual_bpm_t', t)&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P3 bpm log err: {_e!r}', flush=True)&amp;#10;try:&amp;#10;    if ecg_renderer is not None:&amp;#10;        ecg_renderer.update(t, plateau_bpm)&amp;#10;        ecg_renderer.draw()&amp;#10;except Exception as _e:&amp;#10;    print(f'[PSYCHOPY] P3 ECG err: {_e!r}', flush=True)&amp;#10;status_text.draw()" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
